<dialog>
  <element type="tab" rect="fillwindow">
    <attributes>
      <attribute key="DrawBackground" value="true" />
      <attribute key="BackColor" value="128, 128, 128, 128" />
      <attribute key="Name" value="EditProfile_TextureParams" />
      <attribute key="Visible" value="false" />
    </attributes>
    
    <children>
      <element type="MenuBackground" rect="relative: 33, 9, 63, 40">
        <attributes>
          <attribute key="UseOverrideColor" value="true" />
          <attribute key="OverrideColor" value="232, 239, 239, 255" />
        </attributes>
        
        <children>
          <element type="MenuButton" rect="relative: 27, 1, 29, 3" tooltip="Close the dialog">
            <attributes>
              <attribute key="Name" value="EditProfile_EditParamsClose" />
              <attribute key="ImagePath" value="data/images/btn_cancel.png" />
            </attributes>
          </element>
  
          <element type="MenuButton" rect="relative: 1, 4, 29, 6" tooltip="Select a texture pattern">
            <attributes>
              <attribute key="Name" value="EditProfile_BtnPattern" />
              <attribute key="Caption" value="Texture Pattern" />
            </attributes>
          </element>
          
          <element type="MenuButton" rect="relative: 1, 7, 29, 9" tooltip="Change the texture's number color">
            <attributes>
              <attribute key="Name" value="EditProfile_BtnNoFore" />
              <attribute key="Caption" value="Number Foreground Color" />
            </attributes>
          </element>
          
          <element type="MenuButton" rect="relative: 1, 10, 29, 12" tooltip="Change the texture's number background color">
            <attributes>
              <attribute key="Name" value="EditProfile_BtnNoBack" />
              <attribute key="Caption" value="Number Background Color" />
            </attributes>
          </element>          
          
          <element type="MenuButton" rect="relative: 1, 13, 29, 15" tooltip="Change the texture's number ring border color">
            <attributes>
              <attribute key="Name" value="EditProfile_BtnNoRing" />
              <attribute key="Caption" value="Number Ring Color" />
            </attributes>
          </element>          
          
          <element type="MenuButton" rect="relative: 1, 16, 29, 18" tooltip="Change the glow color of the number">
            <attributes>
              <attribute key="Name" value="EditProfile_BtnNoFrame" />
              <attribute key="Caption" value="Number Glow Color" />
            </attributes>
          </element>          
          
          <element type="MenuButton" rect="relative: 1, 19, 29, 21" tooltip="Change the texture's pattern color">
            <attributes>
              <attribute key="Name" value="EditProfile_PattrnFore" />
              <attribute key="Caption" value="Pattern Foreground Color" />
            </attributes>
          </element>          
          
          <element type="MenuButton" rect="relative: 1, 22, 29, 24" tooltip="Change the texture's number background color">
            <attributes>
              <attribute key="Name" value="EditProfile_PattrnBack" />
              <attribute key="Caption" value="Pattern Background Color" />
            </attributes>
          </element>          
          
          <element type="MenuButton" rect="relative: 1, 27, 29, 29" tooltip="Import a custom texture">
            <attributes>
              <attribute key="Name" value="EditProfile_CustomTexture" />
              <attribute key="Caption" value="Import Custom Texture" />
            </attributes>
          </element>          
        </children>
      </element>
    </children>
  </element>
</dialog>